{
  "name": "noc-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:http": "VITE_NOC_API=http vite",
    "stub": "tsx server/stub.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server --noEmit",
    "test": "vitest run",
    "contract:sync": "node scripts/sync-contract-types.mjs",
    "perf:build": "vite build --mode perf --outDir dist-perf && vite build --mode perf-http --outDir dist-perf-http"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.22.2"
  }
}
